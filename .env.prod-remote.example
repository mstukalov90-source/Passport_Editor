# Optional: connect Django directly to prod geodb via SSH tunnel (not for daily dev).
# 1) In a separate terminal:
#    ssh -N -L 5433:127.0.0.1:5433 pasp-ssh-user@172.21.197.77
# 2) cp .env.prod-remote.example .env  (and fill passwords)
# Stop local postgis-db first if port 5433 is in use.

POSTGIS_DB_HOST=127.0.0.1
POSTGIS_DB_PORT=5433
POSTGIS_DB_NAME=geodb
POSTGIS_DB_USER=postgres
POSTGIS_DB_PASSWORD=<from /opt/passport_editor_new/.env on 172.21.197.77>
POSTGIS_DB_CONNECT_TIMEOUT=10

# QGIS read-only (unchanged)
QGIS_DB_HOST=localhost
QGIS_DB_PORT=5432
QGIS_DB_NAME=mggt_asu
QGIS_DB_USER=mstukalov
QGIS_DB_PASSWORD=<your password>
QGIS_DB_CONNECT_TIMEOUT=10

GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
AXES_ENABLED=0
