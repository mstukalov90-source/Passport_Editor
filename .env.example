# geodb (default) — локальный Docker postgis-db (./scripts/local_postgis_up.sh)
POSTGIS_DB_HOST=127.0.0.1
POSTGIS_DB_PORT=5433
POSTGIS_DB_NAME=geodb
POSTGIS_DB_USER=postgres
POSTGIS_DB_PASSWORD=postgres
POSTGIS_DB_CONNECT_TIMEOUT=10

# QGIS read-only витрина (mggt_asu на 172.21.197.51)
QGIS_DB_HOST=172.21.197.51
QGIS_DB_PORT=5432
QGIS_DB_NAME=mggt_asu
QGIS_DB_USER=mstukalov
QGIS_DB_PASSWORD=<your password>
QGIS_DB_CONNECT_TIMEOUT=10

GDAL_LIBRARY_PATH=/opt/homebrew/lib/libgdal.dylib
GEOS_LIBRARY_PATH=/opt/homebrew/lib/libgeos_c.dylib
E2E_LOGIN=e2e_test
E2E_PASSWORD=e2e_test_pass
E2E_OWNER_ID=E2E_OWNER
# DJANGO_ENABLE_ADMIN=0   # на VPS: отключить /admin/
# GIS_TOP_TABLE=top
# GIS_TOP_SOURCE_LABEL=ТОП
# AXES_ENABLED=0          # отключить блокировку логина (локально; в pytest отключается автоматически)
# HOME_WORKFLOW_MODAL_ENABLED=0  # автопоказ «Выберите действие» на home (1 = включить)

# QGIS ingest API (POST /approval/api/qgis/approves/) — только внутренний адрес сервера
# APPROVAL_QGIS_API_URL=http://172.21.197.77/approval/api/qgis/approves/
# APPROVAL_QGIS_ALLOWED_HOSTS=172.21.197.77,127.0.0.1,localhost,testserver
# Первый деплой модуля «Согласование»: approval_docs/PROD_DEPLOY.md
